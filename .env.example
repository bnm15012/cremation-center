# ── Database (TiDB / MySQL) ───────────────────────────────────────────────────
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DATABASE=cremation_centre
MYSQL_USER=your_user.root
MYSQL_PASSWORD=your_password

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cremation-docs

# ── SMTP (for invite emails) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Cremation Centre <you@gmail.com>

# ── App URL (used in invite email links) ─────────────────────────────────────
APP_URL=https://your-vercel-domain.vercel.app

# ── Razorpay (AMC yearly maintenance: ₹5999, expires 31st Dec 23:59:59) ───────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Optional: Seed script defaults ───────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@cremation.local
SEED_ADMIN_PASSWORD=Admin@123
